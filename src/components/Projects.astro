---
import ProjectCard from "../components/ProjectCard.astro";
import { getCollection } from "astro:content";

const projects = await getCollection("projects");
const webDevProjects = projects.filter((project) => project.data.type === "Web development");
const hobbyProjects = projects.filter((project) => project.data.type !== "Web development");
---

<main>
    <div class="container">
        <div>
            <h1 class="project-header">Web Development</h1>
            <div class="project-container">
                {webDevProjects.map((project) => (
                    <ProjectCard project={project} />
                ))}
            </div>
        </div>
        <div>
            <h1 class="project-header">Hobby</h1>
            <div class="project-container">
                {hobbyProjects.map((project) => (
                    <ProjectCard project={project} />
                ))}
            </div>
        </div>
    </div>
</main>
 
<style>
    .tags ul {
        list-style: none;

    }

    .container {
        height: fit-content;
        align-items: start;
    }
    
    .container > div {
        padding: 2rem;
    }

    .project-container {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 1rem;

        margin-top: 1rem;

        width: 100%;
        max-width: 100%;
    }

    .project-header {
        font-size: 1.8rem;
        color: var(--red1);
    }
    @media (max-width: 1080px) {
        .project-container {
            grid-template-columns: 1fr 1fr;
        }
    }

    @media (max-width: 700px) {
        .project-container {
            grid-template-columns: 1fr;
        }
    }
</style>