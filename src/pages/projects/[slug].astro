---
import { getCollection, render } from "astro:content";
import Layout from '../../layouts/Layout.astro';
import { LightGallery } from 'astro-lightgallery'

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.data.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, year, description, sources, tags, images } = project.data;

---

<Layout>
	<main>
		<div class="container">
			<article>
				<h1 class="title">{title}</h1>
				<p class="date">{year}</p> 
				<div class="sources">
					{sources && sources.length > 0 && (
						<div class="sources">
							{sources.map((source) => (
								<a class="source" target='_blank' rel="noopener noreferrer" href={source.url}>{source.label}</a>
							))}
						</div>
					)}
				</div>
				{tags && tags.length > 0 && (
				<div class="tags">
					{tags.map((tag) => (
					<p>{tag}</p>
					))}
				</div>
				)}

				<p class="desc"><span class="tldr">TLDR</span> {description}</p>

				{images && images.length > 0 && (
				<LightGallery
				layout={{
					imgs: images.map(img => ({
						...img,
						src: img.src.startsWith(import.meta.env.BASE_URL) ? img.src : import.meta.env.BASE_URL+img.src,
					}))
				}}
				options={{
					thumbnail: true
				}}
				/>
				)}

				<!-- Markdown body -->
				<div class="content">
					<Content />
				</div>
			</article>
		</div>
	</main>
</Layout>

<style>
	astro-lightgallery :global(a) {
		display: none;
	}

	astro-lightgallery :global(a > img) {
		border-radius: 1rem;
	}

	astro-lightgallery :global(a:nth-child(1), a:nth-child(2)) {
		display: block;
	}

	.container {
		height: fit-content;
	}

	article {
		padding: 2rem 20cqw;
	}

    .date {
        color: var(--yellow1);
		margin: 0.5rem 0;
    }

	.tldr {
		color: var(--yellow1);
		font-weight: 700;
	}

	.desc {
		margin: 2rem 0;
	}

    h1 {
        color: var(--red1);
		font-size: clamp(1.5rem, 1.5vw, 2rem);
    }

	.content :global(h2) {
		margin: 2rem 0 1rem 0;
		color: var(--yellow1);
	}

	.content :global(iframe) {
		width: 100%;
		aspect-ratio: 16/9;
		margin: 2rem 0;
	}

	.content :global(em) {
		color: var(--white1)
	}

    .source, .content :global(a) {
        color: var(--red1);
        overflow-wrap: anywhere;
    }

	.sources {
		display: flex; 
		flex-direction: row;
		gap: 1rem;
	}

	.tags {
        display: flex;
        flex-direction: row;
        flex-wrap: wrap;
        width: fit-content;
        gap: 0.3rem;
        color: var(--bg-light);
        font-size: 0.9rem;
        margin-top: 1rem;
    }

    .tags > p {
        background-color: var(--green1);
        border-radius: 5rem;
        padding: 5px 10px 5px 10px;
    }

	@media (max-width: 1250px) {
		article {
			padding: 2rem 10cqw;
		}
</style>