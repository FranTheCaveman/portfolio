---
import { themes } from '../data/themes';
import Navbar from '../components/Navbar.astro'
const DEFAULT_THEME_NAME = 'kanagawa-wave';
---

<!doctype html>
<html lang="en">
	<!-- Set default theme -->
	<script is:inline define:vars={{ themes, DEFAULT_THEME_NAME }}>
		document.addEventListener('DOMContentLoaded', function () {
			var savedThemeName = localStorage.getItem('user-theme') || DEFAULT_THEME_NAME;
			var activeTheme = themes.find(t => t.name === savedThemeName) || themes[0];
			var root = document.documentElement;
			
			var container = document.getElementById('colour-scheme-container');
			if (container) var fragment = document.createDocumentFragment();

			let i = 0;
			Object.entries(activeTheme.colours).forEach(function (entry) {
				var key = entry[0], value = entry[1];
				root.style.setProperty('--' + key, value);

				if (container && i >= 4) {
					var newDiv = document.createElement('div');
					newDiv.classList.add('colour');
					newDiv.style.backgroundColor = value;
					fragment.appendChild(newDiv);
				}

				i ++;
			});

			root.setAttribute('data-theme', activeTheme.name);
			root.setAttribute('data-theme-type', activeTheme.type);
			if (container) container.appendChild(fragment);
		});
	</script>

	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Francisca</title>
	</head>
	<header>
		<Navbar />
	</header>
	<body>
		<div class="container">
			<slot />
		</div>
	</body>
</html>

<style is:global>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;

		scroll-behavior: smooth;
		background-color: var(--bg-dark);
	}

	/* body:before {
		content: "";
		position: absolute;
		top: 0; left: 0; right: 0; bottom: 0;
		
		background-image: url("../assets/bg.svg");
		background-size: cover;

		filter: blur(5rem) opacity(60%);

		z-index: -1; 
	} */


	header {
		display: flex;
		align-items: center;
		justify-content: center;

		top: 0;
		width: 100%;
		z-index: 1000;
		position: sticky;
	}

	:root {
		background-color: #16161d;
		color: var(--fg-main);

		font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
		line-height: 1;
	}

	@font-face {
			font-family: 'VeraMono-Bold';
			src: url(`${import.meta.env.BASE_URL}fonts/Bitstream-Vera-Sans-Mono/VeraMono-Bold.ttf`) format('truetype');
			font-weight: normal;
			font-style: normal;
	}

	@font-face {
			font-family: 'VeraMono';
			src: url(`${import.meta.env.BASE_URL}fonts/Bitstream-Vera-Sans-Mono/VeraMono.ttf`) format('truetype');
			font-weight: normal;
			font-style: normal;
	}

	p, h1, h2, h3, ul, li {
		margin-top: 0.5em;
		margin-bottom: 0;
	}

	.container {
		background-color: var(--bg-main);
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;

		width: 95%;
		height: 90%;

		margin: 0 auto;
		border-radius: 2rem;
		overflow: hidden;

		font-family: 'VeraMono-Bold';

		transition: outline 0.2s ease-out;
		outline: 2px rgba(158, 154, 236, 0.1) solid;
	}

	.container:hover {
		outline: 2px rgba(170, 133, 229, 0.3) solid;
	}
</style>
